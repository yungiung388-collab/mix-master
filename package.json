{
  "name": "mix-master-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --use-system-ca node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build",
